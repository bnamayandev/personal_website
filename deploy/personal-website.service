# systemd unit for the Pi. Install with:
#   sudo cp /srv/website/deploy/personal-website.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now personal-website
#
# Secrets come from /etc/personal-website.env (root-owned, chmod 600). systemd
# reads it before dropping privileges, so the service user cannot read the file
# itself and nothing secret lives in the web directory.

[Unit]
Description=Personal website (Express + live Spotify/Steam stats)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node server/index.js
WorkingDirectory=/srv/website
EnvironmentFile=/etc/personal-website.env
Environment=NODE_ENV=production HOST=127.0.0.1
Restart=on-failure
RestartSec=5

# Sandboxing: throwaway unprivileged user, read-only filesystem, no new
# privileges. (MemoryDenyWriteExecute is left off: it breaks Node's JIT.)
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
