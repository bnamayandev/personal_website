# Copy to .env and fill in. .env is gitignored. These are read only by the
# Node server (server/*.js); they are never bundled into the frontend.

# --- Spotify ---------------------------------------------------------------
# 1. Log in at https://developer.spotify.com/dashboard and click "Create app".
#    Tick "Web API". Dev-mode apps need the owner to have Spotify Premium.
# 2. In the app's settings add this exact Redirect URI:
#      http://127.0.0.1:8888/callback
# 3. Copy the Client ID and Client secret (Settings > Basic Information) here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 4. Run `node server/get-spotify-token.js`, open the link it prints, approve,
#    and paste the refresh token it prints here.
SPOTIFY_REFRESH_TOKEN=
# Redirect URI registered in the Spotify app settings (used only by the helper).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# How many tracks / albums / artists to show.
SPOTIFY_LIMIT=4

# --- Steam -----------------------------------------------------------------
# Key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Your 64-bit SteamID (find it at https://steamid.io).
STEAM_ID=
STEAM_LIMIT=4

# --- Server ----------------------------------------------------------------
PORT=3001
# How long to cache the Spotify top items and Steam games before refetching.
# (Spotify "listening now" is cached for 20 seconds.)
STATS_CACHE_MINUTES=10
